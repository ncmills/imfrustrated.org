{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["./*.test.ts", "../../src/app/api/intake/route.ts"]
}
